*;
* Reaction definitions. ;
*;
% 1.32D-12 * (TEMP / 300) ** -0.7: OH + SO2 = HSO3; # Wine et al.,1984
% 4.8D-11*EXP(250/TEMP) : OH + HO2 = H2O + O2 ; # IUPAC
% 2.20D-13*KMT06*EXP(600/TEMP)+1.90D-33*M*KMT06*EXP(980/TEMP) : HO2 + HO2 = H2O2 ; # IUPAC
% 6.9D-31 * (TEMP / 300) ** -0.8 * p / 1.3806488D-23 / TEMP / 1D6 : OH + OH = H2O2 ; # Zellner et al., 1988
% 6.2D-14 * (TEMP / 298)**2.6 * EXP(945/TEMP) : OH + OH  = H2O + O; # IUPAC
% 1.3D-12*EXP(-330/TEMP)* O2 : HSO3   =  HO2 + SO3 ; # IUPAC
% 3.9D-41 * EXP(6830.6 / TEMP) * H2O * H2O : SO3  = H2SO4 ; # IUPAC
% kDimer(modelparams): H2SO4 + H2SO4 = H2SO4H2SO4; # SA dimerization
% kTrimer(modelparams): H2SO4H2SO4 + H2SO4 = (H2SO4)3; # SA trimerization
% kTrimer(modelparams): H2SO4H2SO4 + (H2SO4)3 = (H2SO4)5; # higher clustering
% kTrimer(modelparams): (H2SO4)3 + (H2SO4)3 = (H2SO4)6; # higher clustering
% kTrimer(modelparams): H2SO4H2SO4 + H2SO4H2SO4 = (H2SO4)4; # higher clustering
% KMT05 : CO + OH = HO2;
% itProd(modelparams) : H2O = OH + H;
% 5.4D-32 * (TEMP/300)**-1.8 * N2 : H + O2 = HO2;
